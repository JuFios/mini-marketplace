{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Mini Marketplace backend (NestJS)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
