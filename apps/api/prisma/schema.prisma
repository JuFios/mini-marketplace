// Data model. Constraints Prisma cannot express (CHECK, extensions) live in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The API compiles to CommonJS (Nest 11 + Jest), so the generated client must too.
  moduleFormat = "cjs"
  // Extensionless relative imports are valid in CommonJS and resolve in Jest, unlike the
  // default `.js` suffix that only TypeScript maps back to the `.ts` sources.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING // awaiting the worker
  PAID // mock charge succeeded
  FAILED // mock charge declined, order cancelled
  REFUNDED // cancelled after payment (mock refund)
  VOIDED // cancelled before the charge
}

enum CancelReason {
  CUSTOMER_REQUEST
  ADMIN_ACTION
  PAYMENT_FAILED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(254)
  name          String         @db.VarChar(100)
  passwordHash  String         @map("password_hash")
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshTokens RefreshToken[]
  cartItems     CartItem[]
  orders        Order[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @db.Uuid // equals the JWT `jti`
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(200)
  description String      @db.Text
  price       Decimal     @db.Decimal(12, 2)
  stock       Int
  imageUrl    String?     @map("image_url") @db.VarChar(2048)
  categoryId  String      @map("category_id") @db.Uuid
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([categoryId, price])
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([price])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model CartItem {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  status          OrderStatus   @default(NEW)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  paymentRef      String?       @map("payment_ref") @db.VarChar(64)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  shippingAddress String        @map("shipping_address") @db.VarChar(500)
  idempotencyKey  String        @map("idempotency_key") @db.VarChar(64)
  cancelReason    CancelReason? @map("cancel_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  productName String  @map("product_name") @db.VarChar(200)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}
