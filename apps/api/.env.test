# Environment of the e2e suite (`npm run test:e2e -w api`). Throwaway local services only: this
# file is committed and must never hold a real secret.
#
# Variables already set in the environment (CI) win over this file, and `.env.test.local`
# (git-ignored) wins over it; use that file to point at services on non-default ports.
NODE_ENV=test
LOG_LEVEL=silent
SWAGGER_ENABLED=true
# A dedicated database and Redis DB index: the suite truncates every table and flushes Redis
# between test files, and refuses to run against anything that does not look like a test target.
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/mini_marketplace_test
REDIS_URL=redis://localhost:6379/1
