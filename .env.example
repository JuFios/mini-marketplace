# Mini Marketplace — environment template.
#
# Two ways to run, one file:
#
# * The whole stack in Docker (`docker compose up --build`) needs NO `.env`: every variable below
#   has the same default inside docker-compose.yml. Create one only to change a value; the
#   compose-only variables are in the last section.
# * Development on the host (`npm run dev -w api`, …) needs a `.env`: copy this file to `.env`
#   (it is git-ignored) and start the dependencies with `docker compose up -d postgres redis`.
#
# Never put real secrets in this file: it holds safe placeholders only.

# --- API ---
PORT=3000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Serves Swagger UI at /api/docs
SWAGGER_ENABLED=true
# Keep in sync with the POSTGRES_* values below.
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/mini_marketplace
REDIS_URL=redis://localhost:6379
# HS256 signing keys, at least 32 characters each and different from each other.
# Placeholders for local development only: generate real ones with `openssl rand -base64 48`.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-987654321
# Token lifetimes in seconds (access 15 minutes, refresh 7 days)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Set to true wherever the API is served over HTTPS
COOKIE_SECURE=false
# How many reverse proxies stand in front of the API (0 = it is reached directly). Rate limits
# are per client address: behind a proxy that address is only known from X-Forwarded-For, which a
# direct client could forge, so it is believed only for this many hops. docker compose sets 1 (nginx).
TRUST_PROXY=0
# Product image uploads: directory (relative to apps/api; docker compose uses a volume at /data/uploads)
# and size limit in bytes
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=2097152
# Upper bound, in seconds, for serving a cached catalog response
CATALOG_CACHE_TTL_SECONDS=120
# The mock payment provider run by the worker: the share of orders it declines (0 = none, 1 = all;
# an order's verdict is fixed, so retries never flip it) and how long a charge takes.
PAYMENT_MOCK_FAILURE_RATE=0.1
PAYMENT_MOCK_DELAY_MS=1000

# --- Database seed (prisma db seed) ---
# The seeded administrator. Change the password for any shared environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
# The demo customer (customer@example.com) that owns the seeded order history.
DEMO_CUSTOMER_PASSWORD=Customer12345

# --- docker compose ---
# Database credentials. Inside the stack the API reaches PostgreSQL as `postgres:5432` with
# these values; DATABASE_URL above is only for processes running on the host. Keep the password
# URL-safe (letters and digits): it is placed in a connection URL as it is.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=mini_marketplace
# Database used by the e2e tests; created when the data volume is first initialised.
POSTGRES_TEST_DB=mini_marketplace_test
# Host ports of the dependencies, for development on the host. Left unset, Docker picks free
# ones (so a fresh clone never collides with a PostgreSQL or Redis already on the machine).
# Change them when something else listens here, and update DATABASE_URL / REDIS_URL above.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Where the web app (and, through it, Swagger at /api/docs) is served. The default host is
# loopback only; use 0.0.0.0 to serve the network, after replacing the published passwords and keys.
WEB_HOST=127.0.0.1
WEB_PORT=8080
